
{% style %}
.testimonial-section {
  padding: 50px 20px;
  background-color: {{ section.settings.background_color }};
  {% if section.settings.background_image %}
    background-image: url({{ section.settings.background_image | image_url }});
    background-size: cover;
    background-position: center;
  {% endif %}
}
.testimonial-block, .testimonial-image-block {
  margin-bottom: 30px;
}
.testimonial-stars {
  color: gold;
}
{% endstyle %}

<div class="testimonial-section">
  <div class="page-width">
    <h2 class="section-title">{{ section.settings.section_title }}</h2>
    <div class="testimonial-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'testimonial' %}
            <div class="testimonial-block">
              <div class="testimonial-stars">
                {% for i in (1..5) %}
                    {% if i <= block.settings.rating %}
                    ★
                    {% else %}
                    ☆
                    {% endif %}
                {% endfor %}
                </div>
              <div class="testimonial-comment">{{ block.settings.comment }}</div>
              <p><strong>{{ block.settings.author }}</strong></p>
              {% if block.settings.show_date %}
                <small>{{ block.settings.date }}</small>
              {% endif %}
              {% if block.settings.enable_social %}
                <div class="testimonial-social">
                  <!-- Example share icons -->
                  <a href="#" aria-label="Share on Facebook">🔗 Facebook</a> |
                  <a href="#" aria-label="Share on Twitter">🔗 Twitter</a>
                </div>
              {% endif %}
            </div>

          {% when 'image' %}
            {% if block.settings.block_image != blank %}
              <div class="testimonial-image-block">
                <img src="{{ block.settings.block_image | image_url }}" alt="Testimonial Image" loading="lazy">
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Jane Doe"
        },
        {
          "type": "richtext",
          "id": "comment",
          "label": "Comment",
          "default": "<p>This product is amazing! Highly recommended.</p>"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "July 30, 2025"
        },
        {
          "type": "checkbox",
          "id": "show_date",
          "label": "Show date",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "enable_social",
          "label": "Enable social share icons",
          "default": false
        }
      ]
    },
    {
      "type": "image",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "block_image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}

